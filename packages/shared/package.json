{
  "name": "@ajaia/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript types and DTOs for the Ajaia monorepo.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no tests in @ajaia/shared' && exit 0",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "tsup": "^8.2.4",
    "typescript": "^5.5.3"
  }
}
